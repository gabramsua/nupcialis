{
  "name": "nupcialis",
  "version": "0.0.0",
  "description": "SaaS multi-tenant de organización de bodas",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "build": "ng build",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "emulators": "npm run functions:build && firebase emulators:start",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "functions:build": "npm --prefix functions run build",
    "functions:install": "npm --prefix functions install",
    "functions:test": "npm --prefix functions test",
    "icons": "node tools/build-icon-sprite.mjs",
    "lint": "ng lint",
    "ng": "ng",
    "prepare": "husky",
    "seed": "node tools/seed-emulador.mjs",
    "start": "ng serve",
    "test": "ng test",
    "test:rules": "firebase emulators:exec --only firestore --project nupcialis-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "tokens": "node tools/tokens.mjs",
    "tokens:check": "node tools/tokens.mjs --check",
    "typecheck:rules": "tsc -p tsconfig.rules.json",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "firebase": "^12.18.0",
    "npm": "^11.19.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.5.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html,scss,json,md}": [
      "prettier --write"
    ],
    "*.{ts,html}": [
      "eslint --fix"
    ]
  }
}
