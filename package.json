{
  "name": "nupcialis",
  "version": "0.0.0",
  "description": "SaaS multi-tenant de organización de bodas",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run check:plantillas && ng build",
    "check:plantillas": "node tools/comprueba-plantillas.mjs",
    "deploy:functions": "node tools/desplegar-functions.mjs",
    "deploy:prod": "npm run deploy:rules -- --project prod && npm run deploy:functions -- --project prod",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "functions:build": "npm --prefix functions run build",
    "functions:install": "npm --prefix functions install",
    "functions:test": "npm --prefix functions test",
    "icons": "node tools/build-icon-sprite.mjs",
    "lint": "ng lint",
    "ng": "ng",
    "prepare": "husky",
    "start": "npm run check:plantillas && ng serve",
    "test": "npm run check:plantillas && ng test",
    "test:rules": "firebase emulators:exec --only firestore --project nupcialis-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "tokens": "node tools/tokens.mjs",
    "tokens:check": "node tools/tokens.mjs --check",
    "typecheck:rules": "tsc -p tsconfig.rules.json",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "firebase": "^12.18.0",
    "jodit": "^4.19.14",
    "leaflet": "^1.9.4",
    "ngx-jodit": "^3.2.3",
    "npm": "^11.19.1",
    "read-excel-file": "^9.3.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@phosphor-icons/core": "^2.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html,scss,json,md}": [
      "prettier --write"
    ],
    "*.{ts,html}": [
      "eslint --fix"
    ]
  }
}
