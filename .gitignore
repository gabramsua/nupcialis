# Credenciales y secretos
# Ojo: los ficheros de src/environments SÍ se versionan. La configuración web de
# Firebase (apiKey, projectId...) no es un secreto: viaja en el bundle que
# descarga cualquier invitado. La seguridad la dan las reglas y App Check.
# Solo se ignoran las sobrescrituras locales.
src/environments/*.local.ts
**/serviceAccountKey.json
.env
.env.*
!.env.example

# Datos personales de invitados
scripts/data/
*.csv
!docs/**/*.csv

# Node
/node_modules
functions/node_modules
npm-debug.log
yarn-error.log

# Build
/dist
/tmp
/out-tsc
functions/lib
.firebase/

# Angular
/.angular/cache
.sass-cache/

# Emuladores
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# Cobertura y tests
/coverage
__screenshots__/

# IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json
!.vscode/tasks.json
!.vscode/launch.json
.history/*

# Sistema
.DS_Store
Thumbs.db
